<% if(success && success.length>0) {%>
  <div class="row">
  <div class="alert alert-success mt-4 col-6 offset-3 alert-dismissible fade show" role="alert">
    <h5><%= success %></h5>
     <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
  <% } %>

  <% if(error && error.length>0) {%>
  <div class="row">
  <div class="alert alert-success mt-4 col-6 offset-3 alert-dismissible fade show" role="alert">
    <h5><%= error %></h5>
     <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
  <% } %>